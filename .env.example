# Copy this to .env and fill in your values before running `docker compose up`.

# ----- Receiver auth -----
# This is what you'll enter as the "CloudShark API key" in Meraki Dashboard
# (Network-wide > General > Packet capture > CloudShark integration).
# Generate one with: python -c "import secrets; print(secrets.token_hex(16))"
# Treat it like a password - anyone with it (and network access to the
# receiver) can upload files to your machine.
CLOUDSHARK_RECEIVER_TOKEN=

# ----- Public hostname -----
# A domain/subdomain you control, with DNS managed by Cloudflare (needed for
# the DNS-01 challenge below). This is what goes in Meraki's "CloudShark URL"
# field, along with CLOUDSHARK_PORT.
CLOUDSHARK_DOMAIN=cloudshark.example.com
# The external port you'll forward from your router/host to this stack.
# Doesn't need to be 443 - DNS-01 doesn't require port 80/443 for validation,
# so pick whatever's free. Must match the port you forward and the port you
# put in Meraki's CloudShark URL (e.g. https://cloudshark.example.com:8443).
CLOUDSHARK_PORT=8443

# ----- Cloudflare DNS-01 challenge -----
# API token scoped to "Edit zone DNS" on the zone that owns CLOUDSHARK_DOMAIN
# only. Create at: Cloudflare Dashboard > My Profile > API Tokens > Create
# Token > "Edit zone DNS" template.
CLOUDFLARE_API_TOKEN=
