{
	servers {
		protocols h1 h2
	}
}

# Matches BOTH the real hostname and any other Host header (e.g. a raw IP).
# This second form is required: Meraki's own client resolves the hostname to
# an IP and sends that literal IP as the HTTP Host header (while still using
# the correct hostname for TLS SNI) - without the catch-all, Caddy's
# host-based routing would reject those requests before they ever reach the
# receiver. See README.md for the full story.
{$CLOUDSHARK_DOMAIN}:{$CLOUDSHARK_PORT}, :{$CLOUDSHARK_PORT} {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	log {
		output file {$CLOUDSHARK_LOG_PATH:caddy_access.log}
		format json
	}

	# NOTE: /captures browsing/download access control lives in server.py
	# (query-param token), not here. An IP-based restriction was tried first
	# but Docker Desktop's networking on Windows doesn't preserve real client
	# source IPs for published ports - every inbound connection looks like it
	# comes from the same internal gateway address, confirmed empirically by
	# successfully browsing /captures from a genuinely different public IP
	# despite the restriction being in place. See README.md.
	reverse_proxy {$CLOUDSHARK_UPSTREAM:localhost:8642}
}
